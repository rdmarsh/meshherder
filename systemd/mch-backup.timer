[Unit]
Description=Daily Mesh Herder desired-state backup
Documentation=https://github.com/rdmarsh/meshherder#readme

[Timer]
# Once a day; Persistent catches up a missed run after downtime, and the random delay avoids
# firing exactly at midnight.
OnCalendar=daily
Persistent=true
RandomizedDelaySec=30min

[Install]
WantedBy=timers.target
