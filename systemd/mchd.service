[Unit]
Description=mchd — Mesh Config Herder
After=network.target
# Wait for the USB gateway device if it has a udev rule
After=dev-meshcore0.device
Wants=dev-meshcore0.device

[Service]
Type=simple
# Recommended: create a dedicated system account with no login shell:
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin --comment "Mesh Config Herder" mch
#   sudo usermod -aG dialout mch
# Users who need mch CLI access must be in the mch group:
#   sudo usermod -aG mch <username>
# For a single-user / dev setup you can use your own account instead.
User=mch
Group=mch
# dialout group is required for serial port access
SupplementaryGroups=dialout

WorkingDirectory=/usr/local/etc/mch
ExecStart=/usr/local/bin/mchd --config /usr/local/etc/mch/config.yaml
Restart=on-failure
RestartSec=10

# Hardening - keep the daemon's blast radius small
NoNewPrivileges=yes
ProtectSystem=strict
# read-only rather than yes so a venv under /home can be used as ExecStart
ProtectHome=read-only
# DB and socket directories need write access; config dir needs write access
# because commissioning writes secrets.yaml atomically via a .tmp sibling file.
# ProtectSystem=strict makes /usr read-only, so /usr/local/etc/mch must be
# listed explicitly.
ReadWritePaths=/usr/local/etc/mch /var/lib/mch /run/mch
# Serial port access
DeviceAllow=/dev/meshcore0 rw
DeviceAllow=char-tty rw

# Creates /run/mch/ with 0750 and cleans it on stop.
# socket_path in config.yaml must be /run/mch/mchd.sock
RuntimeDirectory=mch
RuntimeDirectoryMode=0750

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mchd

[Install]
WantedBy=multi-user.target
